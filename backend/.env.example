# Copy to .env and fill in. All keys are optional — the app runs without them
# (news falls back to a mock provider, chat falls back to a canned summary).

# NewsAPI.org — keyword search, last ~30 days on free tier. Optional.
# https://newsapi.org/register
NEWSAPI_API_KEY=

# Exa AI — default news provider. Semantic search with historical date windows.
# https://dashboard.exa.ai
EXA_API_KEY=

# OpenRouter — enables LLM-powered chat analysis. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional overrides (defaults shown) ---
# NEWS_PROVIDER=exa                        # exa | newsapi | mock
# CHAT_MODEL=deepseek/deepseek-v4.1-flash  # must be one of CHAT_MODELS in config.py
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MOVEMENT_THRESHOLD=2.0
# NEWS_MAX_MOVES_WITH_NEWS=6
# NEWS_MAX_ARTICLES_PER_SCOPE=3
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
